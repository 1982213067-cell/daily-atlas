# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== 云端数据存储（服务端读写，前端只做本地缓存）=====
# 必填：这两个值已从源码里移除，缺任意一个服务端会直接启动失败并提示。
# 本地写在项目根目录的 .env；线上写到托管平台的环境变量面板。
# 注意：.env 已被 .gitignore 忽略，千万别提交到仓库。
WB_CLOUD_REST="https://your-cloud-host/.cloud/database/rest/wbapp_state"
WB_CLOUD_KEY="your-cloud-access-key"

# ===== 跨域（只在前后端分开部署时需要）=====
# 同源整站部署（本机 / Render / 单服务）留空即可，留空不注册 CORS 中间件。
# 前后端分离时填前端的源，多个用英文逗号分隔：https://daily-atlas.pages.dev,http://localhost:3000
# CORS_ORIGIN="https://your-frontend-domain"

# ===== 访问口令（Basic Auth）默认不启用 =====
# 现在默认无需口令，链接直接打开即可。
# 若你想重新加一道门禁，取消下面注释并填一个口令，重启服务即可生效：
# APP_USER="me"
# APP_PASSWORD="你的口令"

# 服务端口，默认 3000（云平台会自动注入 PORT，不要写死）
# PORT="3000"
